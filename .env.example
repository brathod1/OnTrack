# OnTrack — copy this file to `.env` and fill in the values.
#
# IMPORTANT: the file must be named `.env`, NOT `.env.local`.
# The Prisma CLI reads `.env` only and ignores `.env.local`. Next.js reads
# both. One `.env` therefore serves both tools; using `.env.local` produces a
# baffling "Environment variable not found: DATABASE_URL" during migrations
# while the Next.js app appears to work fine.
#
# `.env` is gitignored. Never commit it.
#
# Passwords: use letters and numbers only. These values sit inside URLs, where
# @ : / ? # % & have structural meaning and will break the connection string.

# ── Database ────────────────────────────────────────────────────────────────
# RUNTIME — Prisma Client connects as ontrack_app, which deliberately cannot
# UPDATE or DELETE the activity log, or DELETE tasks and time entries.
DATABASE_URL="postgresql://ontrack_app:PASSWORD@localhost:5432/ontrack?schema=public"

# MIGRATIONS — Prisma Migrate, db push/pull and Studio connect as the owner.
# Referenced by `directUrl` in schema.prisma. Never used by the running app.
DIRECT_DATABASE_URL="postgresql://ontrack_owner:PASSWORD@localhost:5432/ontrack?schema=public"

# ── Microsoft Entra ID (SSO) ────────────────────────────────────────────────
# App registration → Overview for the first two, Certificates & secrets for the third.
AUTH_MICROSOFT_ENTRA_ID_ID="00000000-0000-0000-0000-000000000000"
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# The firm's tenant id. Restricting to a single tenant is what stops any
# Microsoft account in the world from reaching the sign-in callback.
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID="00000000-0000-0000-0000-000000000000"

AUTH_SECRET=""            # openssl rand -base64 32
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"    # local dev only

# ── Attachments (Azure Blob Storage) ────────────────────────────────────────
# Private container. Downloads are served via short-lived, user-bound SAS
# tokens after the same read check as the parent task — never a public URL.
AZURE_STORAGE_ACCOUNT=""
AZURE_STORAGE_CONTAINER="ontrack-attachments"
AZURE_STORAGE_CONNECTION_STRING=""
ATTACHMENT_MAX_BYTES="26214400"          # 25 MB
SAS_EXPIRY_MINUTES="5"

# ── Email (Microsoft Graph) ─────────────────────────────────────────────────
# Only used for the one email this phase sends: "a task was assigned to you".
GRAPH_SENDER_ADDRESS="ontrack@kcmehta.com"
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
NOTIFICATION_EMAIL_ENABLED="true"

# ── Behaviour ───────────────────────────────────────────────────────────────
# A timer running longer than this is SUSPENDED and the user is asked how long
# they actually worked. It is never silently logged.
TIMER_WATCHDOG_HOURS="10"
# Entries older than this need a manager to approve the backdating.
MANUAL_ENTRY_BACKDATE_DAYS="30"
# How far ahead the recurrence job materialises tasks.
RECURRENCE_HORIZON_DAYS="45"

TZ="Asia/Kolkata"
