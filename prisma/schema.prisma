// OnTrack — Task Management Core
// Phase 1 schema. Scope per "docs/OnTrack — Task Core Build Spec.md".
//
// Conventions:
//   - Durations are integers in MINUTES. Never floats, never seconds.
//   - An INSTANT is @db.Timestamptz(3) — timestamp WITH time zone. Prisma's
//     default (TIMESTAMP(3), no zone) is internally consistent but silently
//     wrong to anything reading the database directly: pgAdmin, a SQL report,
//     Power BI. Being explicit costs nothing and removes a whole class of bug.
//   - A CALENDAR DAY is @db.Date. `work_date` is the day work happened, not an
//     instant: Friday's work logged on Monday stays dated Friday, and no
//     report shifts across a UTC boundary.
//   - Nothing is hard-deleted except join rows.
//   - The app DB role has INSERT/SELECT only on activity_log. See
//     prisma/sql/02_grants.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Two URLs, two roles — this is what makes the restricted grants real.
  //
  //   url       → ontrack_app.   Prisma Client at runtime. Cannot UPDATE or
  //               DELETE activity_log, cannot DELETE tasks or time entries.
  //   directUrl → ontrack_owner. Prisma Migrate, db push/pull, Studio. Owns
  //               the schema; holds CREATEDB for the shadow database.
  //
  // Without this split, migrations would run as the application role — which
  // would mean granting the app the very privileges the grants file withholds.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ───────────────────────────────────────────────────────────── enums

enum Role {
  ADMIN
  PARTNER
  MANAGER
  MEMBER
}

/// Drives default capacity expectations and whether review defaults on.
enum Grade {
  PARTNER
  DIRECTOR
  MANAGER
  ASSISTANT_MANAGER
  SENIOR
  EXECUTIVE
  ARTICLE
}

enum UserStatus {
  PENDING // signed in via Entra, awaiting admin approval
  ACTIVE
  INACTIVE // leaver; never deleted
}

enum EngagementCapacity {
  PARTNER
  MANAGER
  IN_CHARGE
  MEMBER
}

enum EngagementStatus {
  ACTIVE
  ON_HOLD
  CLOSED
}

/// Blocked is deliberately NOT here — it is a flag on Task, so a blocked task
/// keeps its real workflow position.
enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

enum Priority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum DueDateType {
  STATUTORY // fixed by law; movable only by Admin, with a reason
  CLIENT_COMMITTED
  INTERNAL
}

enum TimeEntrySource {
  TIMER
  MANUAL
  ADJUSTMENT
}

enum ActivityAction {
  TASK_CREATED
  TASK_ASSIGNED
  TASK_REASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  DUE_DATE_CHANGED
  ESTIMATE_CHANGED
  BLOCKED
  UNBLOCKED
  CONTRIBUTOR_ADDED
  CONTRIBUTOR_REMOVED
  COMMENT_ADDED
  COMMENT_EDITED
  COMMENT_DELETED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  ATTACHMENT_DOWNLOADED
  TIMER_STARTED
  TIMER_STOPPED
  TIMER_SUSPENDED
  TIME_LOGGED
  TIME_EDITED
  TIME_DELETED
  SUBMITTED_FOR_REVIEW
  REVIEW_APPROVED
  REVIEW_REJECTED
  TASK_COMPLETED
  TASK_REOPENED
  TASK_CANCELLED
  REPORT_EXPORTED
}

enum NotificationType {
  ASSIGNED_TO_ME
  REVIEW_REQUESTED
  REVIEW_REJECTED
  DUE_DATE_CHANGED
  MENTIONED
  ADDED_AS_CONTRIBUTOR
}

enum RecurrenceFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

// ─────────────────────────────────────────────────── organisation & config

/// The organisation using OnTrack.
///
/// ─────────────────────────────────────────────────────────────────────────
/// CA-FIRST, CONFIGURABLE. This row is where anything that would otherwise be
/// hardcoded to one firm lives: timezone, date format, task-key prefix, search
/// language, and the vocabulary the UI uses.
///
/// There is one row today and the application assumes so. It is NOT a
/// multi-tenant boundary — tasks are not filtered by organisation, and adding
/// that later means adding an organizationId predicate to the permission
/// kernel, not restructuring the schema. That is a deliberate deferral: the
/// cost of doing it now is real and the benefit is zero while there is one
/// organisation.
///
/// What this DOES buy immediately is that "Asia/Kolkata", "TSK-", "english"
/// and the word "Client" stop being facts about the software.
/// ─────────────────────────────────────────────────────────────────────────
model Organization {
  id        BigInt  @id @default(autoincrement())
  name      String
  shortName String? @map("short_name")
  logoUrl   String? @map("logo_url")

  /// IANA zone. Drives the day boundary for task keys, work dates and
  /// "due today" — all of which were silently IST before this existed.
  timezone String @default("Asia/Kolkata")
  /// date-fns pattern for display. Indian firms read 26 Aug 2026, not 8/26/26.
  dateFormat String @default("dd MMM yyyy") @map("date_format")
  /// 1 = Monday. Drives "due this week".
  weekStartsOn Int   @default(1) @map("week_starts_on")
  /// ISO weekday numbers that are working days. Mon–Sat is common in India.
  workingDays  Int[] @default([1, 2, 3, 4, 5, 6]) @map("working_days")

  /// Prefix for human-quotable task keys: TSK-2026-00001.
  taskKeyPrefix String @default("TSK") @map("task_key_prefix")
  /// PostgreSQL text-search configuration for the search vector.
  searchLanguage String @default("english") @map("search_language")

  /// What this organisation calls things. Shape and defaults in
  /// src/lib/org/terminology.ts. A CA firm keeps Client/Engagement; another
  /// organisation sets Customer/Project without a schema change.
  terminology Json @default("{}")
  /// Everything else that is a setting rather than a column.
  settings Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Roles (step G3) and configurable statuses (step G4) attach here next.
  users   User[]
  teams   Team[]
  clients Client[]

  @@map("organizations")
}

// ───────────────────────────────────────────────────────────── people

model User {
  id            BigInt     @id @default(autoincrement())
  entraObjectId String?    @unique @map("entra_object_id")
  email         String     @unique
  name          String
  role          Role       @default(MEMBER)
  grade         Grade      @default(EXECUTIVE)
  status        UserStatus @default(PENDING)

  organizationId BigInt       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  teamId BigInt? @map("team_id")
  team   Team?   @relation(fields: [teamId], references: [id])

  // Line management. Reporting-line HISTORY is out of scope this phase (Build
  // Spec §2). Known limitation: historical team reports follow the current
  // line, not the line as at the time.
  reportsToId BigInt? @map("reports_to_id")
  reportsTo   User?   @relation("LineManagement", fields: [reportsToId], references: [id])
  reports     User[]  @relation("LineManagement")

  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deactivatedAt DateTime? @map("deactivated_at") @db.Timestamptz(3)
  lastSeenAt    DateTime? @map("last_seen_at") @db.Timestamptz(3)

  tasksAssigned      Task[]            @relation("Assignee")
  tasksCreated       Task[]            @relation("Creator")
  tasksAssignedBy    Task[]            @relation("Assigner")
  tasksReviewing     Task[]            @relation("Reviewer")
  contributions      TaskContributor[]
  contributionsAdded TaskContributor[] @relation("ContributorAddedBy")
  engagements        EngagementMember[]
  timeEntries        TimeEntry[]       @relation("TimeEntryOwner")
  timeEntriesEdited  TimeEntry[]       @relation("TimeEntryEditor")
  comments           Comment[]
  attachments        Attachment[]
  activity           ActivityLog[]
  notifications      Notification[]
  savedViews         SavedView[]
  clientsOwned       Client[]          @relation("RelationshipPartner")
  engagementsLed     Engagement[]      @relation("EngagementPartner")
  engagementsManaged Engagement[]      @relation("EngagementManager")
  recurrenceDefaults RecurrenceRule[]  @relation("RecurrenceDefaultAssignee")

  @@index([status, teamId])
  @@index([reportsToId])
  // Declared so `prisma migrate` recognises the index the migration creates.
  // PostgreSQL does not index foreign keys automatically, and an undeclared
  // index is treated as drift to be dropped.
  @@index([organizationId])
  @@map("users")
}

/// Service line: Statutory Audit, Direct Tax, GST, Internal Audit, etc.
model Team {
  id                    BigInt  @id @default(autoincrement())
  name                  String  @unique
  headUserId            BigInt? @map("head_user_id")
  membersCanCreateTasks Boolean @default(true) @map("members_can_create_tasks")

  organizationId BigInt       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  members     User[]
  engagements Engagement[]

  @@index([organizationId])
  @@map("teams")
}

// ───────────────────────────────────────────────── clients & engagements
// Present to give tasks context and make reporting useful. Deliberately thin:
// no budgets, no billing, no financials (Build Spec §2).

model Client {
  id      BigInt   @id @default(autoincrement())
  name    String
  code    String   @unique
  aliases String[] @default([])

  /// The "Firm — Internal" pseudo-client, so non-client work still has an
  /// engagement and there is exactly one code path.
  isInternal Boolean @default(false) @map("is_internal")
  isActive   Boolean @default(true) @map("is_active")

  organizationId BigInt       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])

  relationshipPartnerId BigInt? @map("relationship_partner_id")
  relationshipPartner   User?   @relation("RelationshipPartner", fields: [relationshipPartnerId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  engagements Engagement[]

  @@index([isActive, name])
  @@index([organizationId])
  // Trigram index for fuzzy client-name matching ("meridan" → "Meridian").
  // Declared so Prisma recognises the index created in the migration.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_clients_name_trgm")
  @@map("clients")
}

model Engagement {
  id       BigInt           @id @default(autoincrement())
  clientId BigInt           @map("client_id")
  client   Client           @relation(fields: [clientId], references: [id])
  name     String // e.g. "Statutory Audit FY 2025-26"
  /// Financial year label, e.g. "2025-26". Free text so odd periods work.
  fy       String?
  status   EngagementStatus @default(ACTIVE)

  teamId BigInt? @map("team_id")
  team   Team?   @relation(fields: [teamId], references: [id])

  partnerId BigInt? @map("partner_id")
  partner   User?   @relation("EngagementPartner", fields: [partnerId], references: [id])
  managerId BigInt? @map("manager_id")
  manager   User?   @relation("EngagementManager", fields: [managerId], references: [id])

  /// Default for tasks created here; each task may override.
  defaultReviewRequired Boolean @default(true) @map("default_review_required")

  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  members         EngagementMember[]
  tasks           Task[]
  recurrenceRules RecurrenceRule[]

  @@unique([clientId, name, fy])
  @@index([status, clientId])
  @@map("engagements")
}

/// The backbone of the visibility model: membership grants task access
/// regardless of line management (Build Spec §4.5).
model EngagementMember {
  id           BigInt             @id @default(autoincrement())
  engagementId BigInt             @map("engagement_id")
  engagement   Engagement         @relation(fields: [engagementId], references: [id], onDelete: Cascade)
  userId       BigInt             @map("user_id")
  user         User               @relation(fields: [userId], references: [id])
  capacity     EngagementCapacity @default(MEMBER)

  validFrom DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo   DateTime? @map("valid_to") @db.Timestamptz(3)

  @@unique([engagementId, userId, validFrom])
  @@index([userId, validTo])
  @@map("engagement_members")
}

// ───────────────────────────────────────────────────────────── tasks

model Task {
  id BigInt @id @default(autoincrement())
  /// Human-quotable, e.g. TSK-2026-00127. Generated by next_task_key().
  displayKey String @unique @map("display_key")

  title       String
  description String?

  engagementId BigInt     @map("engagement_id")
  engagement   Engagement @relation(fields: [engagementId], references: [id])

  // Subtasks are rows in this table. Depth capped at 1 by a DB trigger — a
  // service-layer check is one forgotten code path away from an infinite tree.
  parentTaskId BigInt? @map("parent_task_id")
  parentTask   Task?   @relation("Subtasks", fields: [parentTaskId], references: [id])
  subtasks     Task[]  @relation("Subtasks")

  createdById BigInt @map("created_by_id") // immutable provenance
  createdBy   User   @relation("Creator", fields: [createdById], references: [id])

  assignedById BigInt? @map("assigned_by_id") // mutable; last delegator
  assignedBy   User?   @relation("Assigner", fields: [assignedById], references: [id])

  // Single accountable owner. Required — there is no Backlog state.
  assigneeId BigInt @map("assignee_id")
  assignee   User   @relation("Assignee", fields: [assigneeId], references: [id])

  reviewRequired Boolean @default(true) @map("review_required")
  reviewerId     BigInt? @map("reviewer_id")
  reviewer       User?   @relation("Reviewer", fields: [reviewerId], references: [id])

  status   TaskStatus @default(ASSIGNED)
  priority Priority   @default(NORMAL)

  isBlocked           Boolean   @default(false) @map("is_blocked")
  blockedReason       String?   @map("blocked_reason")
  blockedSince        DateTime? @map("blocked_since") @db.Timestamptz(3)
  expectedUnblockDate DateTime? @map("expected_unblock_date") @db.Date

  /// The internal commitment. Always present.
  dueDate     DateTime    @map("due_date") @db.Date
  dueDateType DueDateType @default(INTERNAL) @map("due_date_type")
  /// Where the law fixes a date. A manager may move dueDate but never past
  /// this — enforced by a CHECK constraint, not just by the service layer.
  statutoryDueDate DateTime? @map("statutory_due_date") @db.Date

  /// Frozen at the first time entry so Estimated-vs-Actual compares like with
  /// like. Never used for individual scoring (Build Spec §6).
  originalEstimateMinutes Int? @map("original_estimate_minutes")
  currentEstimateMinutes  Int? @map("current_estimate_minutes")
  /// Cache of SUM(time_entries.duration_minutes), written in the same
  /// transaction. Reconciled nightly; drift is reported, not silently fixed.
  actualMinutes Int @default(0) @map("actual_minutes")

  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  startedAt    DateTime? @map("started_at") @db.Timestamptz(3) // first IN_PROGRESS
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(3)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(3)
  cancelReason String?   @map("cancel_reason")

  reviewRound Int @default(1) @map("review_round") // rework counter
  reopenCount Int @default(0) @map("reopen_count")

  recurrenceRuleId BigInt?         @map("recurrence_rule_id")
  recurrenceRule   RecurrenceRule? @relation(fields: [recurrenceRuleId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3) // optimistic lock
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  /// Maintained by the tasks_build_search_vector() trigger in the initial
  /// migration, never written by application code. `Unsupported` tells Prisma
  /// the column exists and to leave it alone — without this declaration,
  /// `prisma migrate dev` sees an unknown column and offers to DROP it.
  searchVector Unsupported("tsvector")? @map("search_vector")

  contributors TaskContributor[]
  tags         TaskTag[]
  comments     Comment[]
  attachments  Attachment[]
  timeEntries  TimeEntry[]
  activity     ActivityLog[]

  @@index([assigneeId, status, dueDate])
  @@index([engagementId, status])
  @@index([dueDate, status])
  @@index([reviewerId, status])
  @@index([parentTaskId])
  @@index([isBlocked, status])
  // Declared so Prisma recognises the GIN indexes created in the migration.
  @@index([searchVector(ops: raw("tsvector_ops"))], type: Gin, map: "idx_tasks_search")
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_tasks_title_trgm")
  @@map("tasks")
}

/// Backs next_task_key(), which produces TSK-2026-00001 style keys.
/// Written only by that SQL function — never by Prisma Client. Declared here
/// purely so migrations don't see an unknown table and offer to drop it.
model TaskKeyCounter {
  year  Int    @id
  value BigInt @default(0)

  @@map("task_key_counters")
}

/// One accountable owner + contributors (Build Spec §3). Contributors may log
/// time and comment; they may not change status, dates, priority or assignee.
model TaskContributor {
  id     BigInt @id @default(autoincrement())
  taskId BigInt @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId BigInt @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  addedById BigInt   @map("added_by_id")
  addedBy   User     @relation("ContributorAddedBy", fields: [addedById], references: [id])
  addedAt   DateTime @default(now()) @map("added_at") @db.Timestamptz(3)

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_contributors")
}

model Tag {
  id    BigInt    @id @default(autoincrement())
  name  String    @unique
  color String?
  tasks TaskTag[]

  @@map("tags")
}

model TaskTag {
  taskId BigInt @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tagId  BigInt @map("tag_id")
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([tagId])
  @@map("task_tags")
}

// ───────────────────────────────────────────────────────────── time

model TimeEntry {
  id     BigInt @id @default(autoincrement())
  taskId BigInt @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id])
  userId BigInt @map("user_id")
  user   User   @relation("TimeEntryOwner", fields: [userId], references: [id])

  /// The DAY the work happened — a calendar date, not an instant.
  workDate DateTime @map("work_date") @db.Date

  /// Null for manual entries. A running timer is startedAt set, endedAt null.
  /// Timestamptz because the exclusion constraint builds a tstzrange from
  /// these, and because a timer start is an instant, not a wall-clock reading.
  startedAt DateTime? @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime? @map("ended_at") @db.Timestamptz(3)

  /// Always populated and authoritative, including for timer entries.
  durationMinutes Int             @default(0) @map("duration_minutes")
  source          TimeEntrySource @default(MANUAL)
  note            String? // required when durationMinutes > 480

  /// Set only when someone other than the owner edits. Always audited.
  editedById BigInt?   @map("edited_by_id")
  editedBy   User?     @relation("TimeEntryEditor", fields: [editedById], references: [id])
  editedAt   DateTime? @map("edited_at") @db.Timestamptz(3)
  editReason String?   @map("edit_reason")

  /// Timer exceeded the watchdog ceiling and was suspended pending the user
  /// confirming actual hours. Suspended entries do not count toward totals.
  isSuspended Boolean @default(false) @map("is_suspended")

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  deleteReason String?   @map("delete_reason")

  @@index([userId, workDate])
  @@index([taskId, deletedAt])
  // The single-running-timer rule is a partial unique index added in the
  // migration — Prisma cannot express it. Application checks race; an index
  // cannot.
  @@map("time_entries")
}

// ───────────────────────────────────────────────── collaboration

model Comment {
  id     BigInt @id @default(autoincrement())
  taskId BigInt @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId BigInt @map("author_id")
  author   User   @relation(fields: [authorId], references: [id])

  bodyMd String @map("body_md")
  /// User ids parsed from @mentions at write time.
  mentions BigInt[] @default([])

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  editedAt  DateTime? @map("edited_at") @db.Timestamptz(3) // editable 15 min, then frozen
  /// Soft delete leaves a tombstone. Comments are part of the work record;
  /// silent disappearance is not acceptable in a professional services firm.
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById BigInt?   @map("deleted_by_id")

  attachments Attachment[]

  @@index([taskId, createdAt])
  @@map("comments")
}

model Attachment {
  id        BigInt   @id @default(autoincrement())
  taskId    BigInt?  @map("task_id")
  task      Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  commentId BigInt?  @map("comment_id")
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  /// Key in the private Azure Blob container. Never a public URL — downloads
  /// issue a short-lived user-bound SAS after the same read check as the task.
  blobKey   String @unique @map("blob_key")
  filename  String
  mimeType  String @map("mime_type")
  sizeBytes Int    @map("size_bytes")
  /// PENDING | CLEAN | INFECTED. Not downloadable until CLEAN.
  scanStatus String @default("PENDING") @map("scan_status")

  uploadedById BigInt    @map("uploaded_by_id")
  uploadedBy   User      @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([taskId])
  @@index([commentId])
  @@map("attachments")
}

// ───────────────────────────────────────────────── activity & notifications

/// Append-only. The app DB role is granted INSERT/SELECT only. One table
/// covers task events plus attachment downloads and report exports.
model ActivityLog {
  id      BigInt @id @default(autoincrement())
  taskId  BigInt? @map("task_id")
  task    Task?  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId BigInt @map("actor_id")
  actor   User   @relation(fields: [actorId], references: [id])

  action ActivityAction
  field  String?
  /// JSON so any field type round-trips without a per-type column.
  oldValue Json? @map("old_value")
  newValue Json? @map("new_value")
  /// Mandatory for: deadline change, reopen, cancel, review rejection, and
  /// editing someone else's time.
  reason String?

  requestId String?  @map("request_id")
  ip        String?
  actedAt   DateTime @default(now()) @map("acted_at") @db.Timestamptz(3)

  @@index([taskId, actedAt])
  @@index([actorId, actedAt])
  @@index([action, actedAt])
  @@map("activity_log")
}

model Notification {
  id     BigInt           @id @default(autoincrement())
  userId BigInt           @map("user_id")
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType

  taskId  BigInt? @map("task_id")
  payload Json    @default("{}")

  /// Events on one task within 15 minutes collapse onto the same key.
  coalesceKey String?   @map("coalesce_key")
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)
  emailSentAt DateTime? @map("email_sent_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, readAt, createdAt])
  @@index([coalesceKey])
  @@map("notifications")
}

// ───────────────────────────────────────────────────────── recurrence

/// Deliberately narrow: a rule generates tasks. It is not a workflow
/// automation engine (scope lock).
model RecurrenceRule {
  id           BigInt     @id @default(autoincrement())
  engagementId BigInt     @map("engagement_id")
  engagement   Engagement @relation(fields: [engagementId], references: [id], onDelete: Cascade)

  titlePattern      String  @map("title_pattern") // "GSTR-3B — {period}"
  description       String?
  defaultAssigneeId BigInt? @map("default_assignee_id")
  defaultAssignee   User?   @relation("RecurrenceDefaultAssignee", fields: [defaultAssigneeId], references: [id])
  estimateMinutes   Int?    @map("estimate_minutes")
  priority          Priority    @default(NORMAL)
  reviewRequired    Boolean?    @map("review_required")
  dueDateType       DueDateType @default(STATUTORY) @map("due_date_type")

  frequency RecurrenceFrequency
  /// Which months a quarterly/annual rule fires in (1-12). Empty = every period.
  monthsOfYear Int[] @default([]) @map("months_of_year")
  /// Statutory dates are defined by law, not by an offset: GSTR-3B is due the
  /// 20th of the month FOLLOWING the period. So the rule is period → due date.
  dueDayOfMonth  Int @map("due_day_of_month")
  dueMonthOffset Int @default(1) @map("due_month_offset")
  /// Create the task this many days before it is due, so it can be worked on.
  generateLeadDays Int @default(10) @map("generate_lead_days")

  isActive  Boolean   @default(true) @map("is_active")
  endsOn    DateTime? @map("ends_on") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  instances RecurrenceInstance[]
  tasks     Task[]

  @@index([isActive, engagementId])
  @@map("recurrence_rules")
}

/// Idempotency guard: makes a retried generation job incapable of
/// double-creating a period's task.
model RecurrenceInstance {
  id     BigInt         @id @default(autoincrement())
  ruleId BigInt         @map("rule_id")
  rule   RecurrenceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  /// "2026-04" monthly, "2026-Q1" quarterly, "2025-26" annual.
  periodKey String  @map("period_key")
  taskId    BigInt? @map("task_id")

  /// Set when the prior period's task was still open at generation time. One
  /// of the best early signals of an engagement going wrong.
  previousIncomplete Boolean @default(false) @map("previous_incomplete")
  skipped            Boolean @default(false)
  skipReason         String? @map("skip_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([ruleId, periodKey])
  @@map("recurrence_instances")
}

// ───────────────────────────────────────────────────────── misc

model SavedView {
  id BigInt @id @default(autoincrement())
  /// Null owner = firm-shared preset.
  ownerId BigInt? @map("owner_id")
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name    String
  filters Json
  /// Preloaded views cannot be deleted by users.
  isSystem  Boolean @default(false) @map("is_system")
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ownerId])
  @@map("saved_views")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settings")
}
