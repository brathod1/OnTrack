{
  "name": "ontrack",
  "version": "0.1.0",
  "private": true,
  "description": "Internal task management for K C Mehta & Co LLP",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:test": "node scripts/test-db.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:permissions": "vitest run src/lib/auth",
    "watchdog": "tsx src/jobs/timer-watchdog.ts",
    "watchdog:dry": "tsx src/jobs/timer-watchdog.ts --dry-run"
  },
  "dependencies": {
    "@azure/storage-blob": "^12.26.0",
    "@prisma/client": "^6.3.0",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "next": "^15.1.6",
    "next-auth": "^5.0.0-beta.25",
    "pg-boss": "^10.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "prisma": "^6.3.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  },
  "engines": {
    "node": ">=20.12.0"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  }
}
